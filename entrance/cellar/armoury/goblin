#!/bin/bash
# 1. 自动引入全局艺术库（2层绝对路径雷达精准校准，0%出错率）
source "$(cd "$(dirname "${BASH_SOURCE}")" && pwd)/../../art.sh"

# 🔴 就地附魔声明颜色变量（铁律）
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

# 2. 播放 3 帧完整人形哥布林四肢疯狂摆动、 screech（尖叫）的交替动态动画
for frame in {1..3}; do
    clear

    # ============ 🌟 核心升级：完整人形体哥布林 3D ASCII 四肢摆动动态残影判定 ============
    echo -e "${GREEN}"
    if [ "$frame" -eq 1 ]; then
        # 帧 1：双臂高举、双腿内收 (大开大合准备撕裂)
        echo '                ,      ,       '
        echo '               /(.-""-.)\      '
        echo '              |\  o  o  /|     '
        echo '              | \  __  / |     '
        echo '               /`------`\      '
        echo '              / /  ||  \ \     '
        echo '             / /   ||   \ \    '
        echo '            (_/    ||    \_)   '
        echo '                  /  \         '
        echo '                 /|  |\        '
        echo '                (_|  |_)       '
        echo -e "       ${RED}<<< (◣__◢) ノ🥁 SCREECH! >>>${NC}"
    elif [ "$frame" -eq 2 ]; then
        # 帧 2：左手横扫、右手持刺、重心向右偏移 (突刺位移)
        echo '                ,      ,       '
        echo '               /(.-""-.)\      '
        echo '              |\  o  o  /|     '
        echo '              | \  __  / |     '
        echo '               /`------`\      '
        echo '             ==--  ||    \ \   '
        echo '                   ||     \ \  '
        echo '                   ||      \_) '
        echo '                  /  \         '
        echo '                 /|   \        '
        echo '                (_|    \_)     '
        echo -e "      ${YELLOW}⚡⚡ CLEARING WEAPON RACKS! ⚡⚡${NC}"
    else
        # 帧 3：双臂下砸、双腿大范围外张跨步 (暴力泰山压顶)
        echo '                ,      ,       '
        echo '               /(.-""-.)\      '
        echo '              |\  o  o  /|     '
        echo '              | \  __  / |     '
        echo '               /`------`\      '
        echo '               /|  ||  |\      '
        echo '              / |  ||  | \     '
        echo '             (_/   ||   \_)    '
        echo '                 _/__\_        '
        echo '                /______\       '
        echo '                ||    ||       '
        echo -e "       ${RED}⚔️⚔️  PREPARE TO FIGHT!  ⚔️⚔️${NC}"
    fi
    echo -e "${NC}"

    # ===================== 📜 剧情说明（像素级对齐黄金边框） =====================
    echo '    ************************************************************'
    echo '   *                                                          *'
    echo -e "   *  A wild ${GREEN}GOBLIN${NC} suddenly leaps out from right behind     *"
    echo '   *  the dusty weapon racks in the corner!                   *'
    echo '   *                                                          *'
    echo -e "   *  It ${RED}screeches maniacally${NC} and bars your path onward!    *"
    echo '   *                                                          *'
    echo '    ************************************************************'
    echo ''
    
    # 动画刷新频率：0.25 秒一帧，肢体舞动极具急促感
    sleep 0.5
done

# ===================== 🎮 🎬 第三幕：战局锁定！终极死斗交互选项（包含击败倒地与逃跑关门分镜） =====================
clear
echo "=================================================="
echo -e " 🔥 ${YELLOW}What will you do, master line-wizard?${NC}"
echo "=================================================="
echo -e " 1) ${RED}[Fight]${NC} Draw your sword and unleash elemental clash"
echo -e " 2) ${BLUE}[Flee]${NC} Swiftly backtrack to the safe corridors"
echo "--------------------------------------------------"
printf "Choose option (1/2): "
read CHOICE

echo ""
if [ "$CHOICE" = "1" ]; then
    # ⚔️ 战斗分支：哥布林被击败倒地 3 帧动画
    for die_frame in {1..3}; do
        clear
        echo -e "${RED}"
        if [ "$die_frame" -eq 1 ]; then
            # 💥 战死帧 1：剑光闪烁，哥布林身体倾斜，瞳孔放大
            echo '                  (\-""-/)               '
            echo '                  // * * \\              '
            echo '                 ||   V   ||             '
            echo '                ==--  ||  --==           '
            echo '                     /  \                '
            echo '                    (_|  |_)             '
            echo -e "       ${YELLOW}⚔️  CRITICAL HIT! STEEL MEETS FLESH! ⚔️${NC}"
        elif [ "$die_frame" -eq 2 ]; then
            # 💥 战死帧 2：身体断裂，碎石字符四散抛飞
            echo '               .  (\-""-/)  .            '
            echo '                 // x x \\               '
            echo '                *  |  V  |  *            '
            echo '                 \___/ \___/             '
            echo '                  /       \              '
            echo -e "       ${RED}💥  THE MONSTER CRUMBLES AND COLLAPSES... 💥${NC}"
        else
            # 💥 战死帧 3：彻底倒地瘫痪，化为虚无残骸
            echo '                                         '
            echo '                                         '
            echo '               _ _.-""-._ _              '
            echo '              (____x____x____)           '
            echo '             /________________\          '
            echo -e "       ${GREEN}🔓 [VICTORY]: THE GOBLIN HAS BEEN SLAIN!${NC}"
        fi
        echo ""
        sleep 0.3
    done
    echo "You successfully defeated the monster! The path onward is clear."
    echo "--------------------------------------------------"
else
    # 🏃‍♂️ 逃跑分支：惊慌逃回地窖 3 帧关门动画
    for flee_frame in {1..3}; do
        clear
        echo -e "${CYAN}"
        if [ "$flee_frame" -eq 1 ]; then
            # 🏃‍♂️ 逃跑帧 1：拔腿狂奔，看到地窖大门轮廓
            echo '                    _______              '
            echo '                   |       |             '
            echo '                   |   .   |             '
            echo '                   |_______|             '
            echo -e "       ${BLUE}🏃‍♂️  YOU TURN ON YOUR HEELS AND RUN BLINDLY!${NC}"
        elif [ "$flee_frame" -eq 2 ]; then
            # 🏃‍♂️ 逃跑帧 2：大门逼近，正在轰然关闭
            echo '                 .-----------.           '
            echo '                /           /|           '
            echo '               +-----------+ |           '
            echo '               |   CLOSING | |           '
            echo '               |___________|/            '
            echo -e "       ${YELLOW}🚪  THE HEAVY CELLAR DOOR IS SLAMMING SHUT!${NC}"
        else
            # 🏃‍♂️ 逃跑帧 3：大门彻底锁死，安全隔绝
            echo '             .-------------------.       '
            echo '             |                   |       '
            echo '             |    [ LOCKED ]     |       '
            echo '             |                   |       '
            echo '             `-------------------`       '
            echo -e "       ${GREEN}🔒  SAFE! You are back inside the dark cellar.${NC}"
        fi
        echo ""
        sleep 0.3
    done
    echo "You heavily barricaded the door. The goblin bangs on it in vain."
    echo "--------------------------------------------------"
fi
echo ""
