    echo -e "${YELLOW}"
    echo ' *******  ****  **  *                                         *  **  ****  ******* '
    echo '  *****    ***   *            THE SACRED GOBLET FREED          *   ***    *****  '
    echo '   ***      *                                                       *      ***   '
    echo '                             _______________________________ '
    echo '                            |@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@|'
    echo '                            |@@@@@@@@@@@@@@@|@@@@@@@@@@@@@@@|'
    echo '                            |@@@@@@@@@@@@@@@|@@@@@@@@@@@@@@@|'
    echo '                             \_______  ###########  _______/ '
    echo '                                     \   #######   /         '
    echo '                                      \   #####   /          '
    echo '                                       \   ###   /           '
    echo '                                        |  ###  |            '
    echo '                                        |  ###  |            '
    echo '                                        |  ###  |            '
    echo '                                       /   ###   \           '
    echo '                                     _|_.__###__._|_         '
    echo '                                    |_______________|        '
    echo '                                    |               |        '
    echo '                                    |  BASH WIZARD  |        '
    echo '                                    |_______________|        '
    echo ' *******  ****  **  *                                         *  **  ****  ******* '
    echo -e "${NC}"

    echo '    ************************************************************'
    echo '   *                                                          *'
    echo -e "   *  🎉 ${GREEN}SUCCESS! The energy fields of orb1, orb2, and orb3${NC}    *"
    echo '   *  resonate together perfectly!                            *'
    echo '   *                                                          *'
    echo -e "   *  You have successfully ${YELLOW}freed the goblet's material form${NC}! *"
    echo -e "   *  Add ${GREEN}'goblet'${NC} to your inventory right now!            *"
    echo '   *                                                          *'
    echo '    ************************************************************'
    echo ''
    exit
else
    # 🌟 状态 B：融炼失败！依然是虚无状态，跳出幽灵淡紫色圣杯
    echo -e "${PURPLE}"
    echo '                             _______________________________ '
    echo '                            |///////////////////////////////|'
    echo '                             \_______  ###########  _______/ '
    echo '                                     \   #######   /         '
    echo '                                      \   #####   /          '
    echo '                                       \   ###   /           '
    echo '                                        |  ###  |            '
    echo '                                       /   ###   \           '
    echo '                                     _|_.__###__._|_         '
    echo '                                    |_______________|        '
    echo -e "${NC}"
    echo '    ************************************************************'
    echo '   *                                                          *'
    echo -e "   *  You try to grasp the faintly glowing, ${PURPLE}ghostly goblet${NC},    *"
    echo '   *  but your hands pass straight through its gaseous form.  *'
    echo -e "   *  The ritual requires ${CYAN}THREE elemental orbs${NC} to solidify... *"
    echo '   *                                                          *'
    echo '    ************************************************************'
    echo ''
fi
# ===================== 📖 🎬 第二幕：双层黑客引导交互（彻底清洗 cat << EOF 截断大巨坑） =====================
printf "Are you stuck in the chamber? Do you need an arch-mage hint? y/n  "
read RESP

if [ "$RESP" = "y" -o "$RESP" = "Y" ]; then
    clear
    echo "============================================================"
    echo -e "💡 ${CYAN}[HINT]: Search opensource.com or manuals on how to COPY files!${NC}"
    echo "============================================================"
    echo ""
    printf "Still completely stuck? Do you need the absolute answer spell? y/n  "
    read RESP

    if [ "$RESP" = "y" -o "$RESP" = "Y" ]; then
        clear
        echo -e "${CYAN}"
        echo ' *******  ****  **  *                                         *  **  ****  ******* '
        echo -e "${NC}"
        echo '    ************************************************************'
        echo '   *                                                          *'
        echo -e "   *  🔮 ${YELLOW}THE INCANTATION OF CLONING REVEALED:${NC}                  *"
        echo -e "   *  The ${GREEN}cp${NC} command copies one existing file to another destination.*"
        echo '   *  Cast these two spells in this exact sequence:           *'
        echo '   *                                                          *'
        echo -e "   *     👉  ${GREEN}cp orb1 orb2${NC}                                      *"
        echo -e "   *     👉  ${GREEN}cp orb1 orb3${NC}                                      *"
        echo '   *                                                          *'
        echo -e "   *  And then run this ${YELLOW}./goblet${NC} script again for confirmation!*"
        echo '   *  The material form will instantly lock into reality.     *'
        echo '   *                                                          *'
        echo '    ************************************************************'
        echo ''
        # 底端粒子闭合线
        echo -e "${CYAN}"
        echo ' *******  ****  **  *                                         *  **  ****  ******* '
        echo -e "${NC}"
        echo ""
    fi
fi



































































































































































































































































