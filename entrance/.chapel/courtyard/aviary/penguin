#!/bin/bash
# 1. 自动引入全局艺术库（3层绝对路径雷达精准校准，0%出错率）
source "$(cd "$(dirname "${BASH_SOURCE}")" && pwd)/../../../art.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

clear

# 🌟 2. 彻底复活并清洗官方核心死亡流机制
gameover () {
    cat << EOF > corpse
You see the corpse of a slain adventurer on the floor of the
dungeon.  You find the following items on the corpse:

${I}

EOF
    curr=`basename $PWD`
    while [ "$curr" != "entrance" ]; do
        pushd .. &> /dev/null
        dirs -c
        curr=`basename $PWD`
    done
    unset I
    unset HP
    $SHELL
}

# 🌟 3. 彻底复活并重构核心企鹅反噬函数（包含 3 帧全屏扑杀暴动动画）
penguin_bite () {
    echo '    ************************************************************'
    echo '   *                                                          *'
    echo -e "   *  The penguin gnaws at your Bag of Holding, hoping for a  *"
    echo '   *  morsel. Finding nothing, it takes a sharp nip at your   *'
    echo '   *  hand for 1 point of damage.                             *'
    echo '   *                                                          *'
    echo '    ************************************************************'
    echo ""
    printf "Do you want to attack the penguin? y/n  "
    read RESP
    if [ "$RESP" = "y" -o "$RESP" = "Y" ]; then
        for frame in {1..3}
        do
            clear
            if [ "$frame" -eq 1 ]; then
                echo -e "${RED}         .---.        .---.        .---.         ${NC}"
                echo -e "${CYAN}        (     )      (     )      (     )        "
                echo "         \\ O O /      \\ O O /      \\ O O /       "
                echo "          | O |        | O |        | O |        "
                echo "         / ___ \\      / ___ \\      / ___ \\       "
                echo "       (( (   ) ))  (( (   ) ))  (( (   ) ))     "
                echo -e "        \"\"     \"\"    \"\"     \"\"    \"\"     \"\"      ${NC}"
                echo -e "   💥 ${RED}<<< MANIACAL PENGUIN MOB MOBILIZING!!! >>>${NC}"
            elif [ "$frame" -eq 2 ]; then
                echo -e "${YELLOW}         .---.        .---.        .---.         ${NC}"
                echo -e "${CYAN}        /     \\      /     \\      /     \\        "
                echo "       |  X X  |    |  X X  |    |  X X  |       "
                echo "        \\  V  /      \\  V  /      \\  V  /        "
                echo "        /     \\      /     \\      /     \\        "
                echo "       (_| _ |_ _ _ (_| _ |_ _ _ (_| _ |_ _ _    "
                echo -e "         ||   ||      ||   ||      ||   ||       ${NC}"
                echo -e "   ⚔️ ${YELLOW}⚡⚡ FLAPPING ATTACKSURGE ACTIVE! ⚡⚡${NC}"
            else
                echo -e "${RED}       ( )   ( )    ( )   ( )    ( )   ( )       "
                echo "        \\_____/      \\_____/      \\_____/        "
                echo "        /     \\      /     \\      /     \\        "
                echo "       |       |    |       |    |       |       "
                echo "       |_______|    |_______|    |_______|       "
                echo -e "        ||   ||      ||   ||      ||   ||       ${NC}"
                echo -e "   💀 ${RED}⚔️⚔️  THE OVAL MASS SURGES UPON YOU! ⚔️⚔️${NC}"
            fi
            echo ""
            sleep 0.25
        done
        clear
        echo "You attack the penguin, quickly doing away with it with one quick slash."
        echo -e "${RED}This draws the absolute attention of the other penguins in the room!${NC}"
        echo "They band together like a legion and rush at you. You fight your best."
        echo "----------------------------------------------------------------------"
        let "HP=HP-5"
        export HP
        if [ "$HP" -le 0 ]; then
            echo -e "💀 ${RED}The furious mob of penguins reduces your hit points to zero...${NC}"
            gameover
            exit 1
        else
            echo -e "❄️ ${BLUE}[ICE SEALED]: A mob of Linux penguins does not tolerate oppression!${NC}"
            echo "You soon find yourself sealed perfectly inside a colossal block of ice."
            echo -e "${CYAN}You stay, perfectly preserved for 128 years. When you thaw, continue...${NC}"
            echo "----------------------------------------------------------------------"
        fi
    else
        echo -e "🕊️  ${GREEN}You keep things in perspective, and do not lash out at the penguin.${NC}"
        let "HP=HP-1"
        export HP
    fi
}
# ===================== 🐧 🎬 第四幕：冰蓝极地企鹅巢穴（纯单引号神盾，100% 绝对垂直对称） =====================
echo -e "${CYAN}"
echo '                   .---.         '
echo '                  /     \        '
echo '                 /  O O  \       '
echo '                 |   V   |       '
echo '                / \_____/ \      '
echo '               / /       \ \     '
echo '              (_/|   _   |\_)    '
echo '                 |  ( )  |       '
echo '                 \_______/       '
echo '                 //     \\       '
echo '                ((       ))      '
echo '                ""       ""      '
echo -e "       ${YELLOW}★ THE FORBIDDEN PENGUIN NEST ★${NC}"
echo ''

echo '    ************************************************************'
echo '   *                                                          *'
echo '   *  One of the ancient birds finally notices your presence. *'
echo '   *  It turns its head sideways, seemingly beckoning for you *'
echo -e "   *  To slowly step ${CYAN}closer and closer${NC}...                    *"
echo '   *                                                          *'
echo '    ************************************************************'
echo ''
printf "Do you get closer to the beckoning bird? y/n  "
read RESP
if [ "$RESP" = "y" -o "$RESP" = "Y" ]; then
    clear
    echo -e "${CYAN}"
    echo '                   .---.         '
    echo '                  /  O O \       '
    echo '                 |   __   |      '
    echo '                  \______/       '
    echo -e "${NC}"
    echo '    ************************************************************'
    echo '   *                                                          *'
    echo -e "   *  You take a step forward, and the bird ${RED}rushes toward you${NC},*"
    echo '   *  its mouth open wide in hungry anticipation!             *'
    echo '   *                                                          *'
    echo '    ************************************************************'
    echo ""
    printf "Do you happen to have a delicious fish in your inventory? y/n  "
    read RESP

    if [ "$RESP" = "y" -o "$RESP" = "Y" ]; then
        if grep --quiet --only-matching fish <<< $I; then
            # 🐟 成功投喂支线！爆发绿光
            clear
            echo -e "${GREEN}"
            echo '               ><(((°>   ><(((°>   ><(((°> '
            echo -e "${NC}"
            echo '    ************************************************************'
            echo '   *                                                          *'
            echo -e "   *  You toss the ${GREEN}fish${NC} at the penguin, which catches it     *"
            echo '   *  mid-air and eagerly gobbles it down in one gulp!        *'
            echo '   *                                                          *'
            echo -e "   *  👉 REMOVE THE FISH FROM YOUR INVENTORY BY RUNNING:      *"
            echo -e "   *     ${YELLOW}export I=\$(sed \"s/fish//; s/,,/,/\" <<< \$I)${NC}"
            echo '   *                                                          *'
            echo '    ************************************************************'
            echo ""
            # 在脚本体内部实时更新环境背包变量，确保联动
            export I=$(sed "s/fish//; s/,,/,/" <<< $I)
        else
            echo -e "🛑 ${RED}You don't have a fish in your Bag of Holding!${NC}\n"
            penguin_bite
        fi
   else
        penguin_bite
   fi
else
    # 选项 N：不靠近，安全离去
    clear
    echo "You back away from the penguin carefully and slowly."
    echo -e "It quickly ${YELLOW}loses interest${NC} in your presence and waddles away into darkness."
    echo "------------------------------------------------------------"
fi

# ===================== 💡 底端教学与防窥线平滑复原 =====================
echo "You can check your health status at any time by typing:"
echo -e "   👉  ${GREEN}echo \$HP${NC}"
echo "============================================================"
echo ""

# 🛡️ 完美的防偷看/防剧透物理折挡块（0%报错卡死）
for i in {1..20}; do echo "#"; done
#
