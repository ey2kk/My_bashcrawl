
#!/bin/bash
# 1. 自动引入全局艺术库（就地声明颜色铁律，3层绝对路径雷达精准校准）
source "$(cd "$(dirname "${BASH_SOURCE}")" && pwd)/../../../art.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

clear

# ===================== 🎬 第一幕：废料堆中的破烂衣物（单引号保护，绝对垂直对称） =====================
echo -e "${PURPLE}"
echo '                     .---.                     '
echo '                    /     \                    '
echo '                ___/_______ \___               '
echo '               /________________\              '
echo '               |  [ OLD RAGS ]  |              '
echo '               |  ============  |             '
echo '               |   ( )   ( )    |               '
echo '               \_______________/               '
echo '                /             \                '
echo '               /_______________\               '
echo -e "          ${YELLOW}★ EXPEDITION WASTE PILE ★${NC}"
echo ''

echo '    ************************************************************'
echo '   *                                                          *'
echo -e "   *  There is a large pile of old, dusty **rags**.           *"
echo '   *  They are heavily worn with age, and probably fell off   *'
echo '   *  the armor of some poor, long-dead adventurer.           *'
echo '   *                                                          *'
echo '    ************************************************************'
echo ''

printf "Do you want to search and take the rags? y/n  "
read RESP

if [ "$RESP" = "y" -o "$RESP" = "Y" ]; then
    # ===================== 🎬 第二幕：回车惊喜！在衣兜里深挖出一尾传世咸鱼 =====================
    clear
    echo -e "${GREEN}"
    echo '               ><(((°>   ><(((°>   ><(((°> '
    echo -e "${NC}"
    echo '    ************************************************************'
    echo '   *                                                          *'
    echo -e "   *  As you lift the cold rags from the stone floor...       *"
    echo -e "   *  ${GREEN}A well-preserved salted FISH slips out from the pocket!${NC} *"
    echo '   *  This must have been the leftover rations of the owner.  *'
    echo '   *  (This smells like the perfect snack for an ice bird...) *'
    echo '   *                                                          *'
    echo '   *  👉 PREFIX THESE TWO ITEMS TO YOUR INVENTORY AT ONCE:    *'
    echo -e "   *     ${YELLOW}export I=rags,fish,\$I${NC}                                *"
    echo '   *                                                          *'
    echo '   *  💡 Remember, you can check your inventory at any time:  *'
    echo -e "   *     ${GREEN}echo \$I${NC}                                              *"
    echo '   *                                                          *'
    echo '    ************************************************************'
    echo ""
    
    # 注入环境变量，保证后续背包联动
    export I="rags,fish,$I"
else
    # 放弃搜刮
    echo "------------------------------------------------------------"
    echo -e "🛑 ${YELLOW}You decide to leave the dirty rags completely untouched.${NC}"
    echo "------------------------------------------------------------"
    echo ""
fi

