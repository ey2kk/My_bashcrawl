clear

# ===================== ❄️ 冬之女王 3D 棱镜白水晶（单引号神盾保护，绝对垂直中轴线死齐） =====================
echo -e "${CYAN}"
echo '                         .             '
echo '                        / \            '
echo '                       /   \           '
echo '                      /  .  \          '
echo '                     /  / \  \         '
echo '                    |  |   |  |        '
echo '                    |  | * |  |        '
echo '                    |  |   |  |        '
echo '                     \  \ /  /         '
echo '                      \  `  /          '
echo '                       \   /           '
echo '                        \ /            '
echo '                         V             '
