echo -e "   ${GREEN}ln -s${NC}             ${WHITE}open a hidden portal${NC}"
echo -e "   ${GREEN}base64 -d${NC}         ${WHITE}reassemble the robot${NC}"
echo -e "   ${GREEN}sha256sum -c${NC}      ${WHITE}verify an artifact${NC}"
echo ''
echo -e "${GOLD} ================================================================ ${NC}"
echo ''
echo -e "${WHITE}   You are now a true line-wizard. Go forth and conquer!${NC}"
echo ''
EOF
        chmod +x end
    else
        echo -e "💥 ${RED}Your sword swings harmlessly. You take 10 points of damage!${NC}"
        let HP=HP-10
        export HP
        echo -e "❤️ ${YELLOW}Current HP:${NC} $HP"
        echo "--------------------------------------------------"
        
        if [ "$HP" -le 0 ]; then
            echo -e "💀 ${RED}The elder god of chaos consumes your body and soul.${NC}"
            echo -e "${RED}GAME OVER!${NC}"
            gameover
            exit 1
        fi
        roll
    fi
}

# ============ 战斗开场 ============
clear
draw_boss
echo "In the blink of an eye, Nyarlathotep is standing before you."
echo -e "From its hands emanate ${PURPLE}black necrotic rays${NC}, and your mind screams."
echo "--------------------------------------------------"
printf "Are you armed? y/n  "
read RESP

if [ "$RESP" = "y" -o "$RESP" = "Y" ]; then
    if grep --quiet --only-matching "sword" <<< $I; then
        roll
    else
        echo -e "${RED}Oh, no! You have lost your blade! Nyarlathotep senses your weakness.${NC}"
        flee
    fi
else
    flee
fi






















































































































































































































































