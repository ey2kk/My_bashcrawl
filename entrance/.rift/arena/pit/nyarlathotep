echo -e "${GOLD}"
echo '        ___________'
echo "       '._==_==_=_.'"
echo '       .-\:      /-.'
echo '      | (|:.     |) |'
echo "       '-|:.     |-'"
echo '         \::.    /'
echo "          '::. .'"
echo '            ) ('
echo "          _.' '._"
echo '         `"""""""`'
echo -e "${NC}"
echo ''

echo -e "${GOLD}"
echo '  __     _____ ____ _____ ___  ______   __'
echo '  \ \   / /_ _/ ___|_   _/ _ \|  _ \ \ / /'
echo '   \ \ / / | | |     | || | | | |_) \ V / '
echo '    \ V /  | | |___  | || |_| |  _ < | |  '
echo '     \_/  |___\____| |_| \___/|_| \_\|_|  '
echo -e "${NC}"
echo ''

echo -e "${WHITE}   CONGRATULATIONS! You have completed Bashcrawl!${NC}"
echo ''
echo -e "${CYAN}   You now know enough Bash to use it for everyday activities.${NC}"
echo -e "${CYAN}   Practice makes perfect, so be sure to use it often.${NC}"
echo ''
echo -e "${GOLD} ================================================================ ${NC}"
echo ''
echo -e "${WHITE}                       YOUR MAGICKAL ARSENAL${NC}"
echo ''
echo -e "   ${GREEN}ls${NC}              ${WHITE}see in the dark${NC}"
echo -e "   ${GREEN}cd <dir>${NC}         ${WHITE}move between rooms${NC}"
echo -e "   ${GREEN}cat file${NC}         ${WHITE}read a scroll${NC}"
echo -e "   ${GREEN}./script${NC}         ${WHITE}trigger an encounter${NC}"
echo -e "   ${GREEN}ls -F${NC}            ${WHITE}tell doors (*) from items${NC}"
echo -e "   ${GREEN}alias${NC}            ${WHITE}cast ls -F with one word${NC}"
