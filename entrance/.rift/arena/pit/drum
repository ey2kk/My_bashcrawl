#!/bin/bash
# 1. 自动引入 3 层外的全局艺术库
source "$(cd "$(dirname "${BASH_SOURCE}")" && pwd)/../../../art.sh"

# 🔴 就地附魔声明颜色变量（铁律）
RED='\033[0;31m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m'

# 2. 播放 6 帧炫彩交替轰鸣
for frame in {1..6}; do
    clear

    # ============ 动态彩色帧判定 ============
    if [ "$((frame % 3))" -eq 1 ]; then
        # 💥 状态 1：红色狂暴音浪
        COLOR="${RED}"
        WAVE_CHAR=")"
    elif [ "$((frame % 3))" -eq 2 ]; then
        # ⚡ 状态 2：蓝色撕裂音浪
        COLOR="${BLUE}"
        WAVE_CHAR="~"
    else
        # 🌌 状态 3：紫色余音低鸣
        COLOR="${PURPLE}"
        WAVE_CHAR="."
    fi

    # ============ 极光色彩渲染矩阵 ============
    echo -e "${COLOR}                          ${WAVE_CHAR}           ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}                      ${WAVE_CHAR}       ${WAVE_CHAR}       ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}                  ${WAVE_CHAR}               ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}              ${WAVE_CHAR}                       ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}          ${WAVE_CHAR}       ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}       ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}        ${WAVE_CHAR}     ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}     ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}      ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${YELLOW}________${COLOR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}    ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}   ${YELLOW}/========\\\\${COLOR}   ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}   ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${YELLOW}|  X  X  X |${COLOR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}  ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}  ${YELLOW}|  X  X  X |${COLOR}  ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}  ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}  ${YELLOW}|  X  X  X |${COLOR}  ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}   ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${YELLOW}|  X  X  X |${COLOR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}    ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}   ${YELLOW}\\========/${COLOR}   ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}      ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}                ${WAVE_CHAR} ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}        ${WAVE_CHAR}    ${WAVE_CHAR} ${WAVE_CHAR}                ${WAVE_CHAR} ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}          ${WAVE_CHAR}    ${WAVE_CHAR}                ${WAVE_CHAR}    ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}            ${WAVE_CHAR}                       ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}              ${WAVE_CHAR}                   ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}                ${WAVE_CHAR}               ${WAVE_CHAR}${NC}"
    echo -e "${COLOR}                  ${WAVE_CHAR}           ${WAVE_CHAR}${NC}"

    # ===================== 剧情文本边框 =====================
    echo '    ************************************************************'
    echo '   *                                                          *'
    echo -e "   *  The deep, rhythmic echoes reverberate through the pit.  *"
    echo -e "   *  You can hear ${YELLOW}drumming${NC} in the distance...                   *"
    echo '   *  It quickens your pulse and chills you to the bone.      *'
    echo '   *                                                          *'
    echo '    ************************************************************'
    
    sleep 0.2
done
